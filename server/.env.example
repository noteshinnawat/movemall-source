# ── Database (PostgreSQL / PgBouncer) ──
# Direct Primary Connection (สำหรับ Migration / DDL)
DATABASE_URL_DIRECT="postgresql://movemall_admin:CHANGE_ME_STRONG_PASSWORD@localhost:5432/movemall?schema=public"

# Connection via PgBouncer Pooler (สำหรับ Application Queries ปกติ)
DATABASE_URL="postgresql://movemall_admin:CHANGE_ME_STRONG_PASSWORD@localhost:6432/movemall?schema=public&pgbouncer=true"

# Read Replica URL (สำหรับ Query หนักๆ / Analytics)
DATABASE_URL_REPLICA="postgresql://movemall_admin:CHANGE_ME_STRONG_PASSWORD@localhost:6432/movemall?schema=public&pgbouncer=true"

# ── In-Memory Cache (Redis) ──
# ⚠️ จำเป็นสำหรับ 2 ฟีเจอร์ด้านความปลอดภัย:
#    1. rate limiting ที่นับรวมข้าม instance (ถ้าไม่มี จะถอยไปนับแยกต่อ instance)
#    2. การเพิกถอน token ตอนออกจากระบบ/เปลี่ยนรหัสผ่าน (ถ้าไม่มี จะใช้งานไม่ได้เลย)
REDIS_URL="redis://localhost:6379"

# ── App & Security ──
PORT=4000
NODE_ENV="development"
# ⚠️ บังคับต้องมี — เซิร์ฟเวอร์จะไม่ยอมสตาร์ตถ้าไม่ได้ตั้งค่า หรือตั้งค่าสั้นกว่า 32 ตัวอักษร
# สร้างค่าใหม่ด้วย: openssl rand -base64 48
JWT_SECRET=""
# อายุ access token (ค่าเริ่มต้น 7d — แนะนำให้ลดลงเมื่อทำ refresh token ใน Phase 3)
JWT_EXPIRES_IN="7d"

# รายชื่ออีเมลผู้ดูแลระบบ คั่นด้วยจุลภาค (ใช้ตรวจสอบเท่านั้น ไม่เลื่อนขั้นอัตโนมัติ)
# การตั้งแอดมินให้รัน: npm run seed:admin -- <email> [password]
SUPER_ADMIN_EMAILS=""

# Google OAuth Client ID ฝั่งเซิร์ฟเวอร์ (ใช้ตรวจ audience ของ token — บังคับต้องมีบน production)
GOOGLE_CLIENT_ID=""

# Secret สำหรับตรวจลายเซ็น webhook ของผู้ให้บริการชำระเงิน (บังคับต้องมีบน production)
PAYMENT_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost:5173"

# ── Cloud Storage (Cloudflare R2 / AWS S3) ──
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="movemall-media"
S3_PUBLIC_URL="https://media.movemall.com"

# ── LINE Official Integration ──
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
LINE_LOGIN_CALLBACK_URL="http://localhost:5173/auth/line/callback"

LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
LINE_MESSAGING_CHANNEL_SECRET=""

# ── ผู้ให้บริการตรวจสอบสลิปโอนเงิน (SlipOK / EasySlip) ──
# ถ้าไม่ตั้งค่า endpoint /api/payment/verify-slip จะตอบ 503 แทนที่จะอนุมัติการชำระเงินให้อัตโนมัติ
SLIP_VERIFY_API_KEY=""

# ── Cloudflare Turnstile (กันบอท) ──
# ไม่ตั้ง = ข้ามการตรวจทุกคำขอ (ใช้ได้กับ dev)
# test key สำหรับทดสอบ: 1x0000000000000000000000000000000AA (ผ่านเสมอ)
#                        2x0000000000000000000000000000000AA (ไม่ผ่านเสมอ)
TURNSTILE_SECRET_KEY=""
